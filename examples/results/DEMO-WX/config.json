{
  "run_id": "DEMO-WX",
  "idea_text": "[design_spec] 微信群讨论归档助手 让一个 50 人以内的小组在微信之外也能把讨论过程沉淀下来、按结论回溯",
  "author": "demo",
  "design_spec": {
    "product_name": "微信群讨论归档助手",
    "goal": "让一个 50 人以内的小组在微信之外也能把讨论过程沉淀下来、按结论回溯",
    "scope": [
      "围绕单个项目建讨论频道，消息按时间线沉淀",
      "讨论可归档并按项目、时间、关键词检索",
      "文件与结论可互相关联，方便复盘"
    ],
    "constraints": [
      "只做 PC 端 Web，不做小程序",
      "单项目成员上限 100",
      "不做已读回执"
    ],
    "features": [
      "讨论频道的消息收发与存储",
      "讨论归档与全文检索",
      "文件与结论的关联登记"
    ],
    "non_goals": [
      "不做即时语音视频",
      "不做跨企业多租户"
    ]
  },
  "flow_ref": "src/scheduler/flow.yaml",
  "gate_ref": "src/scheduler/gate_rule.yaml",
  "agent_ref": "src/agents/agent_config.yaml",
  "budget": {
    "global_llm_calls": 30,
    "per_stage": {
      "P1": 0,
      "P2": 4,
      "P3": 12,
      "P4": 6,
      "P5": 8,
      "P6": 4,
      "P7": 2
    }
  },
  "limits": {
    "max_discussion_rounds": 3,
    "max_task_rounds": 3,
    "max_p5_revisions": 3,
    "max_reworks": 2,
    "max_supplements_per_round": 3,
    "max_supplement_speakers": 2,
    "supplement_max_chars": 80,
    "similarity_threshold": 0.85,
    "score_pass": 80,
    "score_stddev_max": 12,
    "idea_min_chars": 10,
    "challenge_reject_rate": 0.6,
    "max_wave_width": 4,
    "max_steps": 60
  },
  "seed": 42,
  "run_root": "runs",
  "provider": "mock",
  "llm_provider": "offline",
  "parent_run_id": null
}